# Normaliza saltos de línea: LF en el repo, nativo en el working tree.
* text=auto

# El lanzador de workflows rechaza el retorno de carro como caracter de control
# (C-44). Con `text=auto` y `core.autocrlf=true` este fichero salia en CRLF en
# **cada checkout nuevo**, asi que la guarda no fallaba por una edicion: fallaba
# por existir en Windows. Se ancla a LF; el resto del repo sigue como estaba.
*.wf.js text eol=lf

# Binarios: nunca aplicar conversión de texto ni intentar diff.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp4  binary
*.mov  binary
*.mkv  binary
*.webm binary
*.mp3  binary
*.wav  binary
*.aiff binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
