{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|mcp__terminal__run_in_terminal",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/hooks/no-a-mano.py\"",
            "timeout": 10,
            "statusMessage": "Cerrojo: ¿toca la línea a mano?"
          }
        ]
      }
    ]
  }
}