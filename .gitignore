# El material pesado no entra: 46 GB de bruto y 4,6 GB de intermedios.
# Se regeneran desde el bruto y el bruto vive en Drive.
brutos/
tmp/
mi-video/out/
mi-video/public/*.mp4
mi-video/public/musica/
mi-video/public/sfx/
mi-video/work/
mi-video/node_modules/
# El bytecode no es codigo fuente: 25 .pyc comprometidos hacian que un cambio
# de dos ficheros midiera diecinueve en `alcance.py`, que es justamente el
# instrumento con el que se mira si un cambio se paso de alcance.
__pycache__/
mi-video/.parcel-cache/

# Lo que SÍ entra, y por qué:
#   scripts/  src/  docs/  ads/*.json  ads/decisiones.db  skills/
# La base de decisiones pesa 1 MB y es el registro de todo lo decidido —
# libretos, elecciones, descripciones, revisiones. Sin ella el repo tiene el
# código pero no la memoria.

# El diario transitorio de SQLite: existe solo mientras hay una transaccion
# abierta, y comprometerlo guarda el estado A MEDIAS de una escritura.
*.db-journal
*.db-wal
*.db-shm
